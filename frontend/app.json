{
  "expo": {
    "name": "Smart Face Attendance",
    "slug": "smart-face-attendance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "smartattendance",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires access to the camera to register and verify your face for student attendance."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.smartattendance.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Smart Attendance to access camera for facial recognition."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow biometric authentication."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
